@{
    ViewData["Title"] = "Product";
    var products = ViewBag.Products;
}
<div class="row">
    <div class="col-md-3">
        <h2>DANH MỤC</h2>
    </div>
    <div class="col-md-7">
        <h2>Danh sách sản phẩm</h2>
    </div>
</div>
<div class="row">
    <div class="col-md-3" >
        <div class="container">
            <div class="row border" style="padding:5px 10px;">
                <a asp-route="Index" asp-route-ProductType="Phone">Điện thoại</a>
            </div>
            <div class="row border" style="padding:5px 10px;">
                <a asp-route="Index" asp-route-ProductType="Handbag">Túi xách</a>
            </div>
            <div class="row border" style="padding:5px 10px;">
                <a asp-route="Index" asp-route-ProductType="Clothing">Quần áo</a>
            </div>
        </div>
    </div>
    <div class="col-md-7">
        <div class="row">
            @foreach (var product in products)
            {   
                <div class="col-12 col-sm-6 col-md-4 mb-4">
                    <div class="card h-100">
                        <img src="@product.Images" class="card-img-top" alt="@product.ProductName" style="height: 150px; object-fit: contain;"/>
                        <div class="card-body">
                            <h5 class="card-title">@product.ProductName</h5>
                            <p class="card-text">
                                @if (product.Discount > 0)
                                {
                                    <span><del>Giá gốc: @product.Price.ToString("C")</del> giá mới: @((product.Price - (product.Price * product.Discount)).ToString("C"))</span>
                                }
                                else
                                {
                                    <span>Giá: @product.Price.ToString("C")</span>
                                }
                            </p>
                            <a asp-route="Detail" asp-route-id="@product.Id" class="btn btn-success btn-block">Chi tiết</a>
                        </div>
                    </div>  
                </div>
            }
        </div>
    </div>
</div>