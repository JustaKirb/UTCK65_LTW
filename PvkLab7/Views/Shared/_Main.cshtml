<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.css" />
    @RenderSection("Css",required:false)
</head>
<body>
    <nav class="navbar navbar-expand-sm bg-dark">
        <div class="container-fluid">
            <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
            <ul class="navbar-nav">
                <li class="nav-item"><a class="nav-link text-white" asp-controller="Home" asp-action="Index">Trang chủ</a></li>
                <li class="nav-item"><a class="nav-link text-white" asp-controller="Home" asp-action="About">Giới thiệu</a></li>
                <li class="nav-item"><a class="nav-link text-white" asp-controller="Home" asp-action="Contact">Liên hệ</a></li>
            </ul>
            </div>
        </div>
    </nav>
    <div class="container">
        @RenderBody()
    </div>
    <script src="~/lib/jquery/dist/jquery.js"></script>
    <script src="~/lib/boostrap/dist/js/boostrap.js"></script>
    @RenderSection("Scripts",required:false)
</body>
</html>